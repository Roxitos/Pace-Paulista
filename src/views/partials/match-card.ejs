<% const g = r.group; const slug = encodeURIComponent(g.slug); -%>
<article class="card" style="<%= zstyle(g.zone) %>"><div class="match"><span class="match-score" style="--p:<%= r.pct %>"><span><%= r.pct %>%</span></span><div style="min-width:0"><%- include('zone-chip', { zone: g.zone }) -%><h3 style="margin-top:8px"><a href="/grupos/<%= slug %>"><%= g.name %></a></h3><ul class="why"><% for (const w of r.why) { %><li><%- ic('check', 'ico-sm') %><%= w %></li><% } %></ul></div></div>
      <dl class="facts"><div><dt><%- ic('pin', 'ico-sm') %>Local</dt><dd><%= g.location %></dd></div><div><dt><%- ic('cal', 'ico-sm') %>Quando</dt><dd><%= fmtDiasCurto(g.days) %> · <%= fmtHora(g.start_time) %></dd></div><div><dt><%- ic('gauge', 'ico-sm') %>Pace</dt><dd class="mono"><%= fmtFaixa(g.pace_min_s, g.pace_max_s) %></dd></div><div><dt><%- ic('bars', 'ico-sm') %>Nível</dt><dd><%= NIVEIS[g.level].nome %></dd></div></dl>
      <div class="card-actions"><a class="btn btn-primary" href="/conta/entrar?next=/grupos/<%= slug %>%23participar"><%- ic('plus', 'ico-sm') %> Entrar no grupo</a><a class="btn btn-outline btn-sm" href="/grupos/<%= slug %>">Ver detalhes</a><a class="btn btn-outline btn-sm" href="/mapa/<%= slug %>"><%- ic('route', 'ico-sm') %> Ver rota</a></div></article>
