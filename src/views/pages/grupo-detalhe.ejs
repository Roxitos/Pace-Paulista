<%
  const z = ZONAS[group.zone];
  const faixa = fmtFaixa(group.pace_min_s, group.pace_max_s);
  const hora = fmtHora(group.start_time);
  const dias = fmtDiasLongo(group.days);
  const slugUrl = encodeURIComponent(group.slug);
  const flashHere = locals.flash && locals.flash.slug === group.slug ? locals.flash.kind : null;
  const loggedIn = Boolean(locals.user);
  const joinedNow = flashHere === 'joined' && Boolean(locals.membership);
  const joinErrors = (locals.join && locals.join.errors) || {};
  const joinValues = (locals.join && locals.join.values) || { apelido: '', ok: false };
  const joinFirstError = Object.keys(joinErrors)[0];
  const showPanel = loggedIn && (!locals.membership || joinedNow);
  const panelOpen = joinedNow || Boolean(joinFirstError);
  const proxima = locals.nextSession || null;
  const headTag = group.is_demo ? 'Grupo fictício · demonstração' : locals.isOwner ? 'Cadastrado por você' : group.owner_name && `Cadastrado por ${group.owner_name}`;
-%>
<% if (flashHere === 'left') { %><div class="wrap notice-top"><div class="form-alert good" role="status"><%- ic('check') %><span>Você saiu do grupo.</span></div></div>
<% } -%>
<section class="detail-head" style="<%= zstyle(group.zone) %>"><div class="wrap">
    <a class="back" href="/grupos"><%- ic('back', 'ico-sm') %> Voltar para os grupos</a>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center"><%- include('../partials/zone-chip', { zone: group.zone }) -%><% if (headTag) { %><span class="demo-tag" style="color:inherit;border-color:currentColor"><%= headTag %></span><% } %></div>
    <h1 class="display"><%= group.name %></h1>
    <div class="sub"><span><%- ic('pin', 'ico-sm') %><%= group.location %></span><span><%- ic('cal', 'ico-sm') %><%= dias %> · <%= hora %></span><span class="mono"><%- ic('gauge', 'ico-sm') %><%= faixa %></span></div>
  </div></section>
  <div class="wrap"><div class="detail-grid" style="<%= zstyle(group.zone) %>">
    <div>
      <div class="panel"><h2>Sobre o grupo</h2><p><%= group.description %></p></div>
      <div class="panel"><h2>Perfil da comunidade</h2><div class="tags"><% for (const t of group.profile_tags) { %><span class="tag"><%= t %></span><% } %></div></div>
      <div class="panel"><h2>Próximos encontros</h2>
        <ul class="sessions"><% for (const s of sessions) { %><li><span class="date-box"><b><%= s.dia %></b><small><%= s.mes %></small></span><span><b><%= s.semana %>, <%= hora %></b><br><small style="color:var(--muted)"><%= group.location %> · <%= group.distance || 'distância combinada no grupo' %></small></span><span class="mono" style="font-size:13px;color:var(--muted)"><%= faixa %></span></li><% } %></ul>
        <p style="color:var(--muted);font-size:13px;margin-top:10px">Datas calculadas a partir da agenda fixa do grupo. Confirmações por encontro dependem do banco de dados.</p>
      </div>
      <div class="panel"><h2>Antes do primeiro treino</h2><ul class="rules"><li>Chegue 10 minutos antes para o aquecimento.</li><li>Leve água; nos treinos longos, combine hidratação com o grupo.</li><li>Corra sempre pela calçada ou área de pedestres e respeite quem caminha.</li><li>Se o pace estiver puxado, avise: o grupo ajusta.</li></ul></div>
    </div>
    <aside>
      <div class="panel">
        <h2>Ficha do treino</h2>
        <dl class="spec">
          <div><dt><%- ic('pin', 'ico-sm') %>Local</dt><dd><%= group.location %></dd></div>
          <div><dt><%- ic('door', 'ico-sm') %>Ponto de encontro</dt><dd style="font-weight:500"><%= group.meeting_point %></dd></div>
          <div><dt><%- ic('cal', 'ico-sm') %>Dias</dt><dd><%= dias %></dd></div>
          <div><dt><%- ic('clock', 'ico-sm') %>Horário</dt><dd class="mono"><%= hora %></dd></div>
          <div><dt><%- ic('gauge', 'ico-sm') %>Pace</dt><dd class="mono"><%= faixa %></dd></div>
          <div><dt><%- ic('ruler', 'ico-sm') %>Distância</dt><dd class="mono"><%= group.distance || '—' %></dd></div>
          <div><dt><%- ic('bars', 'ico-sm') %>Nível</dt><dd><%- include('../partials/level-meter', { level: group.level }) -%></dd></div>
          <div><dt><%- ic('users', 'ico-sm') %>Participantes</dt><dd class="mono"><%= group.participants %></dd></div>
          <% if (locals.user && group.contact) { %><div><dt><%- ic('ext', 'ico-sm') %>Contato</dt><dd><%= group.contact %></dd></div><% } %>
        </dl>
        <div class="stack" style="margin-top:16px">
          <% if (locals.membership) { %><div class="form-alert good"><%- ic('check') %><span>Você entrou como <b><%= membership.nickname %></b>. Te esperamos no próximo encontro.</span></div>
          <form method="post" action="/grupos/<%= slugUrl %>/sair" class="stack"><%- include('../partials/csrf') %><button class="btn btn-outline" type="submit">Sair do grupo</button></form>
          <% } else if (loggedIn) { %><a class="btn btn-primary btn-lg" href="#participar"><%- ic('plus') %> Entrar no grupo</a>
          <% } else { %><a class="btn btn-primary btn-lg" href="/conta/entrar?next=/grupos/<%= slugUrl %>%23participar"><%- ic('plus') %> Entrar no grupo</a>
          <% } %>
          <a class="btn btn-outline" href="/mapa/<%= slugUrl %>"><%- ic('map', 'ico-sm') %> Ver rota no mapa</a>
        </div>
      </div>
      <% if (showPanel) { %><div class="panel join-panel<%= panelOpen ? ' open' : '' %>" id="participar">
        <% if (joinedNow) { %><div class="success" role="status"><span class="success-ico"><%- ic('check') %></span><h3>Bem-vindo(a), <%= membership.nickname %>!</h3><p style="color:var(--muted)">Você agora faz parte do <b style="color:var(--ink)"><%= group.name %></b>.<% if (proxima) { %> Primeiro treino: <b style="color:var(--ink)"><%= proxima.longa %>, <%= hora %></b>.<% } %></p>
          <div class="stack" style="width:100%"><a class="btn btn-primary btn-block" href="/mapa/<%= slugUrl %>"><%- ic('route', 'ico-sm') %> Ver rota até o encontro</a></div></div>
        <% } else { %><h2>Entrar no <%= group.name %></h2>
        <dl class="spec"><div><dt><%- ic('pin', 'ico-sm') %>Local</dt><dd><%= group.location %></dd></div><div><dt><%- ic('cal', 'ico-sm') %>Próximo treino</dt><dd><%= proxima ? proxima.curta + ' · ' + hora : '—' %></dd></div><div><dt><%- ic('gauge', 'ico-sm') %>Pace</dt><dd class="mono"><%= faixa %></dd></div></dl>
        <form method="post" action="/grupos/<%= slugUrl %>/participar#participar" class="stack" novalidate>
          <%- include('../partials/csrf') %>
          <div class="field"><label for="j-nome">Como o grupo pode te chamar? *</label><input class="input" id="j-nome" name="apelido" maxlength="40" placeholder="Seu primeiro nome ou apelido" autocomplete="given-name" aria-describedby="e-jnome" value="<%= joinValues.apelido %>"<%- joinErrors.apelido ? ' aria-invalid="true"' : '' %><%- joinFirstError === 'apelido' ? ' autofocus' : '' %>><span class="err" id="e-jnome"><%- joinErrors.apelido ? ic('alert', 'ico-sm') : '' %><%= joinErrors.apelido ?? '' %></span></div>
          <label class="check"><input type="checkbox" name="ok" id="j-ok" aria-describedby="e-jok"<%= joinValues.ok ? ' checked' : '' %><%- joinFirstError === 'ok' ? ' autofocus' : '' %>><span>Li as orientações: chegar no horário, levar água e respeitar o ritmo do grupo. *</span></label><span class="err" id="e-jok"><%- joinErrors.ok ? ic('alert', 'ico-sm') : '' %><%= joinErrors.ok ?? '' %></span>
          <button class="btn btn-primary btn-lg btn-block" type="submit" id="joinBtn">Confirmar entrada</button>
          <p style="font-size:12.5px;color:var(--muted)">Pedimos só um apelido. Ele fica na sua conta e é apagado quando você sai do grupo ou exclui a conta.</p>
        </form>
        <% } %>
      </div><% } %>
      <div class="panel"><h2><%= z.nome %></h2><div style="display:flex;gap:14px;align-items:center"><span style="background:var(--z);color:var(--zon);border-radius:50%;display:grid;place-items:center;width:72px;height:72px;flex:none"><%- seal(group.zone, 56) %></span><p style="color:var(--muted);font-size:14.5px"><%= z.desc %></p></div><a class="link" href="/grupos?zona=<%= group.zone %>" style="display:inline-block;margin-top:12px">Outros grupos da <%= z.nome %></a></div>
    </aside>
  </div></div>
