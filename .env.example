# DB_PORT=5433  # descomente (e troque a porta nas URLs abaixo) se a 5432 já estiver ocupada
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://pace:pace@localhost:5432/pace_paulista
# Produção (Neon): conexão direta (host sem -pooler) e ?sslmode=verify-full. Ver docs/DEPLOY.md.
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria
TZ_APP=America/Sao_Paulo
DATABASE_URL_TEST=postgres://pace:pace@localhost:5432/pace_paulista_test
# TRUST_PROXY=1  # número de proxies na frente da app (padrão 1 em produção); no Render é 3, ver docs/DEPLOY.md
# ALLOW_DEMO_SEED=1  # só para publicar os grupos demo em produção
